   "source": [
    "from pyspark.sql import functions as F\n",
    "\n",
    "data = [\n",
    "    (1, \"Laptop\", 50000),\n",
    "    (2, \"Mobile\", 20000),\n",
    "    (3, \"Tablet\", 30000)\n",
    "]\n",
    "\n",
    "df = spark.createDataFrame(\n",
    "    data,\n",
    "    [\"id\", \"product\", \"amount\"]\n",
    ")\n",
    "\n",
    "result = df.withColumn(\n",
    "    \"tax\",\n",
    "    F.col(\"amount\") * 0.40\n",
    ")\n",
    "\n",
    "display(result)"
   ]
  }
